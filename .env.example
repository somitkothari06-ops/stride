# Server-side only. Copy to .env.local and keep it out of Git.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Use an exact NVIDIA model ID available in your account.
NEBIUS_MODEL_FAST=
# Tested with nvidia/Nemotron-3_5-Lightning for short structured tasks.
NEBIUS_DISABLE_THINKING=true
TAVILY_API_KEY=
# Persistent directory on the Devlab workspace. Default: .data
STRIDE_DATA_DIR=
